          "name": "Initiate login via shibboleth provider",
          "request": {
            "name": "Initiate login via shibboleth provider",
            "description": {
              "content": "NOTE that this endpoint only exists if shibboleth is enabled as an\nidentity provider in the fence config. Currently this only happens for\n`login.bionimbus.org`.\n",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "login",
                "shib"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "shib_idp",
                  "value": "<string>",
                  "description": "Identifier for the shibboleth IDP. Available identifiers are what is listed by the `login.bionimbus.org/Shibboleth.sso/DiscoFeed` endpoint. If no `shib_idp` is specified, defaults to NIH login."
                }
              ],
              "variable": []
            },
            "method": "GET",
            "auth": null
          },
          "response": [
