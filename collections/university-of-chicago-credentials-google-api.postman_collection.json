        {
          "id": "c0b68d3a-8aa6-4ed0-9d2a-02d29fa3774d",
          "name": "Receive temporary access key",
          "request": {
            "name": "Receive temporary access key",
            "description": {
              "content": "Get a new temporary Google access key for the current user. The response from this represents exactly what should be placed in a JSON credentials file to pass to Google's APIs.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "credentials",
                "google"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "expires_in",
                  "value": "<integer>",
                  "description": "the time (in seconds) during which the access key is valid. Must be less than the configured maximum (default is 10 days). If it's greater, the configured maximum will be used."
                },
                {
                  "disabled": false,
                  "key": "userProject",
                  "value": "<string>",
                  "description": "a Google Project to bill for accessing data in requester pays buckets in Google Storage. Will override any configured default billing projects. If Fence is configured to automatically attempt to provide the necessary service account(s) billing permission, the provided Google Project will need to have given the Fence admin service account necessary permissions to create custom roles and set Project IAM policies. Please see README for more information."
                }
              ],
              "variable": []
            },
            "header": [
              {
                "key": "Accept",
                "value": "*/*"
              }
            ],
            "method": "POST",
            "auth": {
              "type": "oauth2",
              "oauth2": [
                {
                  "key": "scope",
                  "value": "user"
                },
                {
                  "key": "accessTokenUrl",
                  "value": "/oauth/token"
                },
                {
                  "key": "authUrl",
                  "value": "/oauth/authorize"
                },
                {
                  "key": "grant_type",
                  "value": "authorization_code"
                }
              ]
            }
          },
          "response": [
            {
              "id": "dcc0d813-d092-43e1-80ec-0bbd34e95e6e",
              "name": "Temporary private Google key in Google Credentials File format",
              "originalRequest": {
                "url": {
                  "path": [
                    "credentials",
                    "google"
                  ],
                  "host": [
                    "{{baseUrl}}"
                  ],
                  "query": [
                    {
                      "key": "expires_in",
                      "value": "<integer>"
                    },
                    {
                      "key": "userProject",
                      "value": "<string>"
                    }
                  ],
                  "variable": []
                },
                "header": [
                  {
                    "description": {
                      "content": "Added as a part of security scheme: oauth2",
                      "type": "text/plain"
                    },
                    "key": "Authorization",
                    "value": "<token>"
                  },
                  {
                    "key": "Accept",
                    "value": "*/*"
                  }
