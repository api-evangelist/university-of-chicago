                  "key": "scope",
                  "value": "user"
                },
                {
                  "key": "accessTokenUrl",
                  "value": "/oauth/token"
                },
                {
                  "key": "authUrl",
                  "value": "/oauth/authorize"
                },
                {
                  "key": "grant_type",
                  "value": "authorization_code"
