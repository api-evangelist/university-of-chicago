          "name": "Receive API key",
          "request": {
            "name": "Receive API key",
            "description": {
              "content": "Get a new API key for the current user. API keys can be used to retrieve access tokens which will allow for authed communication to our API. Can pass a list of requested OIDC scopes in the body. Automatically gives \"openid\" scope. Any additional scopes (like \"user\" for seeing user information or \"data\" for hitting signed url endpoint) must be explicitly requested and user must already have access.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "credentials",
                "api"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": []
            },
