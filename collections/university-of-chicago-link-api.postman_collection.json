        {
          "id": "ff7faba9-090d-4511-9445-59b9b4d1776b",
          "name": "Link Google identity to user",
          "request": {
            "name": "Link Google identity to user",
            "description": {
              "content": "Link a Google identity to a User (AuthN using Google Oauth2 flow). Google identity will be associated with a user and added to a proxy group for that user. The user's proxy group will be given access to data via Google's IAM. `redirect` will be stored in the session to follow after linking.\n---\nIf AuthN is successful with Google, eventually will redirect to `/link/google/callback`, where the actual account linkage occur.\n> *See `/link/google/callback` endpoint for details about eventual\n   redirect with descriptive query params about success/failure.*\n",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "link",
                "google"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "redirect",
                  "value": "<string>",
                  "description": "(Required) Page to redirect to after account linking"
                },
                {
                  "disabled": false,
                  "key": "expires_in",
                  "value": "<integer>",
                  "description": "the time (in seconds) during which the Google account has bucket access. Must be less than the configured maximum (default is 24 hours). If it's greater, the configured maximum will be used."
                }
              ],
              "variable": []
            },
            "method": "GET",
            "auth": null
          },
          "response": [
            {
              "id": "3ff71649-35b2-4380-bc97-051221731462",
              "name": "redirect to Oauth2 flow with Google to AuthN user",
              "originalRequest": {
                "url": {
                  "path": [
                    "link",
                    "google"
                  ],
                  "host": [
                    "{{baseUrl}}"
                  ],
                  "query": [
                    {
                      "key": "redirect",
                      "value": "<string>"
                    },
                    {
                      "key": "expires_in",
                      "value": "<integer>"
                    }
                  ],
                  "variable": []
                },
                "method": "GET",
                "body": {}
