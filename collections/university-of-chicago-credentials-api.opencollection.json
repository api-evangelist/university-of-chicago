{
  "opencollection": "1.0.0",
  "info": {
    "name": "Fence OpenAPI Specification admin/user credentials API",
    "version": "0.1.0"
  },
  "items": [
    {
      "info": {
        "name": "credentials",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List credential resources",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://example.domain/credentials",
            "auth": {
              "type": "oauth2",
              "flow": "authorization_code",
              "authorizationUrl": "/oauth/authorize",
              "accessTokenUrl": "/oauth/token",
              "credentials": {
                "clientId": "{{clientId}}",
                "clientSecret": "{{clientSecret}}"
              }
            }
          },
          "docs": "List different resources user can have credentials"
        }
      ]
    }
  ],
  "bundled": true
}